# --- Discord ---
# Token del bot (Developer Portal > Bot > Reset Token). NUNCA lo compartas.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# ID del servidor de Discord donde se registran los comandos slash
DISCORD_GUILD_ID=
# ID del canal donde se publican los avisos de KOTH
DISCORD_CHANNEL_ID=

# --- Boutcraft ---
# Zona horaria IANA oficial de los eventos (no usar offsets fijos como UTC+1)
TIMEZONE=Europe/Madrid
# (no se llama SERVER_IP porque muchos hosts reservan ese nombre)
MINECRAFT_SERVER_IP=boutcraft.xyz

# --- Infraestructura ---
DATABASE_PATH=./data/boutcraft.sqlite
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
