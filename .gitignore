# Dependencias
node_modules/
coverage/

# OJO: `dist/` SÍ se versiona a propósito. El host (bot-hosting.net) descarga el
# repositorio y ejecuta `node dist/index.js` sin compilar, porque su disco y su RAM
# no alcanzan para instalar las herramientas de desarrollo. Ejecuta `pnpm release`
# antes de cada push para que dist/ esté siempre al día.

# Entorno (nunca subir credenciales)
.env
.env.*
!.env.example

# Base de datos local
data/*
!data/.gitkeep

# Logs y sistema
*.log
.DS_Store
Thumbs.db
