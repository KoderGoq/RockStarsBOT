{
  "name": "boutcraft-koth-bot",
  "version": "1.0.0",
  "description": "Bot de Discord que gestiona y anuncia automáticamente los eventos KOTH del servidor de Minecraft Boutcraft.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "commands:deploy": "tsx src/scripts/deploy-commands.ts",
    "commands:deploy:prod": "node dist/scripts/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "keywords": [
    "discord",
    "bot",
    "minecraft",
    "koth",
    "boutcraft"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
